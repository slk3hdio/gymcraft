  "cards": [
    {
      "dot": "cyan",
      "title": "动作下发",
      "items": [
        "动作 = (component_id, Any payload) 列表，批内按输入顺序串行，每动作至少 1 tick",
        "共享 timeout_seconds（≤0 不限制），按 20 tick/秒换算，超时中断当前组件",
        "gRPC 线程阻塞在 CompletableFuture，由服务器 tick 线程（EntityTick Pre/Post）驱动并唤醒"
      ]
    },
    {
      "dot": "emerald",
      "title": "环境与会话",
      "items": [
        "环境仅能场内创建（EnvToolItem / /gymcraft 指令 / RCON 布景），Connect 只按实体 UUID 绑定已有环境",
        "断连标记孤儿会话：10 秒清扫 × 60 秒宽限，瞬断重连透明恢复，新进程可直接接管",
        "组件会话状态挂在 Mob 附件上；reset 从 NBT 快照按原 UUID 重建实体，物品默认清除"
      ]
    },
    {
      "dot": "amber",
      "title": "观测回传",
      "items": [
        "观测 = header + Any 组件地图（gymcraft:self 等 9 项），last_actions 提供逐动作反馈",
        "菜单动作经专属 FakePlayer 会话（不在世界实体集合），Mixin 修补容器开盖计数",
        "聊天观测来自出站包 Mixin 捕获的环形缓冲；visual-1 自定义载荷通道独立推送调试可视化"
      ]
    }
  ]
